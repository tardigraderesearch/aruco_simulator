<mxfile host="drawio"><diagram id="sim" name="ArUco Simulator"><mxGraphModel dx="1200" dy="560" grid="0" gridSize="10" page="1" pageWidth="1200" pageHeight="560" background="#0b0b0b" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g1" value="1  PLACE TAGS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151515;strokeColor=#2e2e2e;fontColor=#a39a94;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Helvetica;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="560" height="300" as="geometry"/></mxCell><mxCell id="g2" value="2  TEST THE CAMERA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151515;strokeColor=#2e2e2e;fontColor=#a39a94;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Helvetica;arcSize=4;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="560" height="300" as="geometry"/></mxCell><mxCell id="g3" value="3  KEEP THE RESULT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151515;strokeColor=#2e2e2e;fontColor=#a39a94;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Helvetica;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1160" height="170" as="geometry"/></mxCell><mxCell id="cad" value="&lt;b&gt;CAD model&lt;/b&gt;&lt;br&gt;STEP, STL, OBJ, PLY, GLB, 3MF&lt;br&gt;&lt;i&gt;original file never modified&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#4a4a4a;fontColor=#f7ece5;fontSize=15;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="230" height="90" as="geometry"/></mxCell><mxCell id="tag" value="&lt;b&gt;Tag tile&lt;/b&gt;&lt;br&gt;OpenCV dictionary, ID, size&lt;br&gt;or a custom code family" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#4a4a4a;fontColor=#f7ece5;fontSize=15;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="place" value="&lt;b&gt;Drag onto a face&lt;/b&gt;&lt;br&gt;snaps to the surface,&lt;br&gt;move, resize, undo / redo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#4a4a4a;fontColor=#f7ece5;fontSize=15;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="230" height="100" as="geometry"/></mxCell><mxCell id="cam" value="&lt;b&gt;Virtual camera&lt;/b&gt;&lt;br&gt;orbit, distance, field of view,&lt;br&gt;blur, noise, exposure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#4a4a4a;fontColor=#f7ece5;fontSize=15;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="230" height="90" as="geometry"/></mxCell><mxCell id="part" value="&lt;b&gt;Move a part&lt;/b&gt;&lt;br&gt;rotate a component;&lt;br&gt;its tags follow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#4a4a4a;fontColor=#f7ece5;fontSize=15;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;ArUco detector&lt;/b&gt;&lt;br&gt;reads only the rendered pixels,&lt;br&gt;never the placement table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#2ee67a;strokeWidth=2;fontColor=#f7ece5;fontSize=15;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="130" width="230" height="100" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;Printable tags&lt;/b&gt;&lt;br&gt;PNG per tag + size manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#4a4a4a;fontColor=#f7ece5;fontSize=15;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="250" height="90" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;Camera frame&lt;/b&gt;&lt;br&gt;raw + annotated PNG,&lt;br&gt;detection JSON" style="rounded=1;whiteSpa